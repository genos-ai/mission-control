{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "opengrep",
          "version": "1.20.0",
          "rules": [
            {
              "id": "python.sqli.text-interpolation",
              "properties": {"tags": ["CWE-89"]}
            },
            {
              "id": "python.hardcoded-secret",
              "properties": {"tags": ["CWE-798"]}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.sqli.text-interpolation",
          "level": "error",
          "message": {"text": "SQL injection via f-string interpolation in text()"},
          "locations": [{
            "physicalLocation": {
              "artifactLocation": {"uri": "app/routes/users.py"},
              "region": {"startLine": 42}
            }
          }]
        },
        {
          "ruleId": "python.hardcoded-secret",
          "level": "warning",
          "message": {"text": "Hardcoded API key detected"},
          "locations": [{
            "physicalLocation": {
              "artifactLocation": {"uri": "app/config.py"},
              "region": {"startLine": 8}
            }
          }]
        },
        {
          "ruleId": "python.sqli.text-interpolation",
          "level": "error",
          "message": {"text": "SQL injection via f-string in raw query"},
          "locations": [{
            "physicalLocation": {
              "artifactLocation": {"uri": "app/routes/admin.py"},
              "region": {"startLine": 15}
            }
          }]
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "ruff",
          "version": "0.12.0",
          "rules": [
            {
              "id": "S608",
              "properties": {"tags": ["CWE-89"]}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "S608",
          "level": "warning",
          "message": {"text": "Possible SQL injection via string formatting"},
          "locations": [{
            "physicalLocation": {
              "artifactLocation": {"uri": "app/routes/users.py"},
              "region": {"startLine": 42}
            }
          }]
        },
        {
          "ruleId": "S105",
          "level": "note",
          "message": {"text": "Possible hardcoded password"},
          "locations": [{
            "physicalLocation": {
              "artifactLocation": {"uri": "app/auth.py"},
              "region": {"startLine": 3}
            }
          }]
        }
      ]
    }
  ]
}
