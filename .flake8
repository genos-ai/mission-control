[flake8]
max-line-length = 100
extend-ignore =
    # E203: whitespace before ':' — conflicts with black
    E203,
    # W503: line break before binary operator — conflicts with black
    W503,
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    modules/backend/migrations/versions,
per-file-ignores =
    # Allow unused imports in __init__.py (re-exports)
    __init__.py:F401
    # Migrations carry long SQL literals and index-definition comments. The
    # exclude list above only applies when flake8 walks a directory; pre-commit
    # passes filenames explicitly, so migrations need an ignore rule as well.
    modules/backend/migrations/versions/*:E501
    # conftest.py must set ALLOW_MODEL_REQUESTS=False (P11) before any
    # model-importing module loads, so later imports are E402 by design
    tests/conftest.py:E402
