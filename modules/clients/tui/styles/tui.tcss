/* Mission Control TUI — Textual CSS */

/* ── Global ────────────────────────────────────────────────────── */

Screen {
    background: $surface;
}

.sidebar-heading {
    text-style: bold;
    color: $text;
    padding: 1 0 0 1;
    height: 2;
}

/* ── Main layout (used by OverviewTab inside workspace) ────────── */

#main-container {
    layout: horizontal;
    height: 1fr;
}

#center-panel {
    width: 1fr;
    min-width: 40;
}

#center-content {
    height: 1fr;
    padding: 1;
}

#right-sidebar {
    width: 32;
    dock: right;
    border-left: solid $surface-lighten-2;
    padding: 0;
}

/* ── Placeholders ─────────────────────────────────────────────── */

.placeholder-panel {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
    border: dashed $surface-lighten-2;
    margin: 1;
}

/* ── Event stream ─────────────────────────────────────────────── */

#event-stream {
    height: 1fr;
}

#event-scroll {
    height: 1fr;
    padding: 0;
}

/* ── Mission header (shared by workspace) ─────────────────────── */

#mission-header {
    dock: top;
    height: 3;
    background: $primary-background;
    layout: horizontal;
    padding: 0 2;
    content-align: center middle;
}

#mission-header Label {
    height: 3;
    content-align: center middle;
}

#mission-name {
    width: 1fr;
    text-align: center;
    text-style: bold;
}

#app-title {
    width: auto;
    text-style: bold;
    color: $text;
}

/* ── Dashboard ────────────────────────────────────────────────── */

#dashboard-header {
    dock: top;
    height: 3;
    background: $primary-background;
    layout: horizontal;
    padding: 0 2;
    content-align: center middle;
}

#dashboard-header Label {
    height: 3;
    content-align: center middle;
}

#dashboard-title {
    width: 1fr;
    text-style: bold;
}

#dashboard-content {
    height: 1fr;
    padding: 1 2;
}

#dashboard-body {
    padding: 1;
}

/* ── Workspace tabs ───────────────────────────────────────────── */

#workspace-tabs {
    height: 1fr;
}

/* ── Project Picker Modal ──────────────────────────────────────── */

ProjectPickerScreen {
    align: center middle;
}

MissionPickerScreen {
    align: center middle;
}

#picker-dialog {
    width: 60;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#picker-dialog Label {
    margin: 0 0 1 0;
}

.project-item {
    height: 3;
    padding: 0 1;
}

.project-item:hover {
    background: $primary-background;
}

.mission-item {
    height: 3;
    padding: 0 1;
}

.mission-item:hover {
    background: $primary-background;
}

#new-project-section {
    margin-top: 1;
    border-top: solid $surface-lighten-2;
    padding-top: 1;
}

#new-project-section Input {
    margin: 0 0 1 0;
}

#new-mission-section {
    margin-top: 1;
    border-top: solid $surface-lighten-2;
    padding-top: 1;
}

#new-mission-section Input {
    margin: 0 0 1 0;
}

/* ── Focus indicators ─────────────────────────────────────────── */

*:focus {
    border: tall $accent;
}

Input:focus {
    border: tall $accent;
}

Button:focus {
    text-style: bold reverse;
}

/* ── Agent sidebar constraints ────────────────────────────────── */

#left-sidebar {
    width: 24;
    min-width: 20;
    max-width: 32;
    dock: left;
    border-right: solid $surface-lighten-2;
}

#agent-sidebar {
    width: 24;
    min-width: 20;
    max-width: 32;
    dock: left;
    border-right: solid $surface-lighten-2;
}

/* ── Notification stack ───────────────────────────────────────── */

#notification-stack {
    height: auto;
    max-height: 8;
    dock: top;
}

/* ── Cost bar ─────────────────────────────────────────────────── */

#cost-bar {
    dock: bottom;
    height: 1;
}

/* ── Mission history modal ────────────────────────────────────── */

MissionHistoryScreen {
    align: center middle;
}

#history-dialog {
    width: 90%;
    height: 85%;
    border: thick $primary;
    background: $surface;
}

/* ── Gate review modal ────────────────────────────────────────── */

GateReviewModal {
    align: center middle;
}

#gate-dialog {
    width: 70%;
    max-width: 100;
    height: auto;
    max-height: 85%;
    border: thick $warning;
    background: $surface;
    padding: 1 2;
}

/* ── Team tab ─────────────────────────────────────────────────── */

#team-container {
    layout: horizontal;
    height: 1fr;
}

#team-list-panel {
    width: 28;
    min-width: 20;
    border-right: solid $surface-lighten-2;
}

#team-list-scroll {
    height: 1fr;
}

#team-detail-panel {
    width: 1fr;
    padding: 1;
}

.prompt-editor-label {
    margin-top: 1;
    text-style: bold;
}

.prompt-editor-actions {
    height: auto;
    margin-top: 1;
}

/* ── Catalog screen ───────────────────────────────────────────── */

#catalog-header {
    dock: top;
    height: 3;
    background: $primary-background;
    layout: horizontal;
    padding: 0 2;
    content-align: center middle;
}

#catalog-header Label {
    height: 3;
    content-align: center middle;
}

#catalog-body {
    layout: horizontal;
    height: 1fr;
}

#catalog-list-panel {
    width: 40;
    min-width: 30;
    border-right: solid $surface-lighten-2;
}

#catalog-list-scroll {
    height: 1fr;
}

#catalog-detail-panel {
    width: 1fr;
    padding: 1;
}

/* ── Catalog browse modal ─────────────────────────────────────── */

CatalogBrowseModal {
    align: center middle;
}

#catalog-modal-dialog {
    width: 80%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#catalog-modal-header {
    height: 3;
    layout: horizontal;
    content-align: center middle;
}

#catalog-modal-list {
    height: 1fr;
    margin-top: 1;
}

.catalog-row {
    height: auto;
    layout: horizontal;
    padding: 0 1;
    margin-bottom: 1;
}

.catalog-row-info {
    width: 1fr;
}

.catalog-add-btn {
    width: auto;
}

/* ── Workflows tab ────────────────────────────────────────────── */

#workflows-container {
    layout: horizontal;
    height: 1fr;
}

#workflows-list-panel {
    width: 28;
    min-width: 20;
    border-right: solid $surface-lighten-2;
}

#workflows-list-scroll {
    height: 1fr;
}

#workflows-detail-panel {
    width: 1fr;
    padding: 1;
}

/* ── Runs tab ─────────────────────────────────────────────────── */

#runs-container {
    layout: horizontal;
    height: 1fr;
}

#runs-list-panel {
    width: 1fr;
    min-width: 40;
    border-right: solid $surface-lighten-2;
}

#runs-list-scroll {
    height: 1fr;
}

#runs-detail-panel {
    width: 1fr;
    padding: 1;
}

#runs-pagination {
    height: 3;
    content-align: center middle;
    dock: bottom;
}

#runs-page-label {
    width: auto;
    content-align: center middle;
    margin: 0 1;
}

/* ── Workshop tab ─────────────────────────────────────────────── */

#workshop-container {
    height: 1fr;
    padding: 1;
}

#workshop-selectors {
    height: 3;
    margin-bottom: 1;
}

#workshop-agent-label {
    width: auto;
    content-align: center middle;
    margin-right: 1;
}

#workshop-agent-select {
    width: 1fr;
}

#workshop-sys-prompt {
    height: 8;
    margin-bottom: 1;
}

#workshop-user-prompt {
    height: 10;
    margin-bottom: 1;
}

#workshop-prompt-actions {
    height: 3;
    margin-bottom: 1;
}

#workshop-output {
    min-height: 5;
    padding: 1;
    border: solid $surface-lighten-2;
    margin-top: 1;
}

.workshop-hidden {
    display: none;
}

/* ── Context tab ──────────────────────────────────────────────── */

#context-container {
    layout: horizontal;
    height: 1fr;
}

#context-doc-panel {
    width: 2fr;
    border-right: solid $surface-lighten-2;
}

#context-doc-scroll {
    height: 1fr;
}

#context-actions {
    height: 3;
    dock: bottom;
    padding: 0 1;
}

#context-size-label {
    width: 1fr;
    content-align: right middle;
}

#context-history-panel {
    width: 1fr;
    min-width: 24;
}

#context-history-scroll {
    height: 1fr;
}

/* ── Admin screen ─────────────────────────────────────────────── */

#admin-body {
    height: 1fr;
    padding: 1;
}

#admin-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#admin-tabs {
    height: 1fr;
}

#admin-catalog-table {
    height: 1fr;
    margin-top: 1;
}

#admin-users-table {
    height: 1fr;
    margin-top: 1;
}

#admin-config-scroll {
    height: 1fr;
}

/* ── Profile screen ──────────────────────────────────────────── */

#profile-body {
    height: 1fr;
    padding: 1 2;
}

#profile-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#profile-name-row {
    height: 3;
    margin-bottom: 1;
}

#profile-name-label {
    width: auto;
    content-align: center middle;
}

#profile-name-input {
    width: 1fr;
}

#profile-keys-table {
    height: auto;
    max-height: 12;
    margin-top: 1;
}

#profile-keys-actions {
    height: 3;
    margin-top: 1;
}

#profile-key-name {
    width: 1fr;
}

/* ── Loading state ────────────────────────────────────────────── */

.loading {
    opacity: 0.5;
}
